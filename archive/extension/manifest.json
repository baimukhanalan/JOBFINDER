{
  "manifest_version": 3,
  "name": "Quick Apply",
  "version": "1.0",
  "description": "Auto-fill job applications with one click",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://173.249.18.153:8000/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon48.png"
  }
}

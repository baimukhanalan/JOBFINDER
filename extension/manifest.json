{
  "manifest_version": 3,
  "name": "Apply Assist",
  "version": "2.3",
  "description": "One-click fill job application forms with your saved profile. Review and submit yourself.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icons/icon48.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["profile.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "fill-form": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill the application form on this page"
    }
  },
  "icons": { "48": "icons/icon48.png", "128": "icons/icon48.png" }
}

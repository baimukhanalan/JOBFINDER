#!/bin/bash
# JobFinder residential proxy — macOS runner.
# Downloads gost (a tiny local HTTP proxy), writes the tunnel key, and keeps a reverse-SSH tunnel
# to the server alive so the server can egress through THIS Mac's home internet. Nothing listens
# publicly — the server side binds loopback only.
#   Run:  bash install-proxy-mac.sh          (installs + optional autostart + runs)
#         bash install-proxy-mac.sh --run    (just the supervisor; used by launchd)
set -u

RHOST="__HOST__"      # proxy.systeam.kz
RPORT=__RPORT__       # server loopback port the tunnel binds (fixed, key-restricted)
LP=__LP__             # local gost port on this Mac
GOST_VER="__GOSTVER__"

BASE="$HOME/Library/Application Support/jobfinder-proxy"
GOST="$BASE/gost"
KEY="$BASE/tunnel_key"
KNOWN="$BASE/known_hosts"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
mkdir -p "$BASE"

install_gost() {
  [ -x "$GOST" ] && return
  echo "downloading gost $GOST_VER ..."
  local arch; arch="$(uname -m)"
  local a="amd64"; [ "$arch" = "arm64" ] && a="arm64"
  curl -fsSL "https://github.com/ginuerzh/gost/releases/download/v${GOST_VER}/gost-darwin-${a}-${GOST_VER}.gz" -o "$BASE/gost.gz"
  gunzip -f "$BASE/gost.gz"
  chmod +x "$GOST"
}

write_key() {
  cat > "$KEY" <<'KEYEOF'
__PRIVKEY__
KEYEOF
  chmod 600 "$KEY"
}

register_autostart() {
  local plist="$HOME/Library/LaunchAgents/com.jobfinder.residentialproxy.plist"
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.jobfinder.residentialproxy</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>$SELF</string><string>--run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict></plist>
PLIST
  launchctl unload "$plist" 2>/dev/null
  launchctl load "$plist" 2>/dev/null && echo "autostart registered (launchd)"
}

supervise() {
  local delay=2
  while true; do
    if ! pgrep -f "gost -L=http://127.0.0.1:$LP" >/dev/null 2>&1; then
      "$GOST" -L="http://127.0.0.1:$LP" >/dev/null 2>&1 &
      sleep 2
    fi
    local t0=$SECONDS
    echo "$(date -u +%FT%TZ) connecting tunnel to $RHOST ..."
    ssh -i "$KEY" -N \
      -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
      -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN" -o BatchMode=yes \
      -R "127.0.0.1:${RPORT}:127.0.0.1:${LP}" "tunnel@$RHOST"
    [ $((SECONDS - t0)) -gt 30 ] && delay=2          # long-lived -> reset backoff
    echo "$(date -u +%FT%TZ) tunnel dropped; reconnecting in ${delay}s"
    sleep "$delay"
    delay=$(( delay * 2 )); [ $delay -gt 60 ] && delay=60   # exponential backoff, capped 60s
  done
}

if [ "${1:-}" != "--run" ]; then
  install_gost
  write_key
  register_autostart || echo "autostart skipped"
  echo "installed. keeping the tunnel up (also runs at login)."
fi
supervise

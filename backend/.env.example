DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobfinder
ANTHROPIC_API_KEY=your_key_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Candidate mailboxes ---------------------------------------------------
# "mailpit"  = local throwaway sink for development (nothing real arrives)
# "selfhost" = real mail on OUR OWN Postfix/Dovecot server (no third-party)
MAIL_PROVIDER=selfhost
# The domain the candidate addresses live on. Must be a domain our Postfix
# accepts (in virtual_mailbox_domains) with MX/SPF/DKIM/DMARC set in DNS.
MAIL_DOMAIN=takhet.com
# selfhost inbound: the Maildir our Postfix delivers into (read under `sg mail`)
MAIL_MAILDIR_BASE=/var/mail/vhosts
# selfhost outbound: submit through our own Postfix (STARTTLS + SASL). The login
# is the domain's submission account (create it on the server with mailadd).
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=587
MAIL_SMTP_LOGIN=bot@takhet.com
MAIL_SMTP_PASSWORD=change_me

# --- Application cap (ATS policy: "no more than N applies per company per window") ---
# Enforced at assignment time so a candidate's over-limit application to a company is
# never even prepared inside the window. 0 disables. Scope is per (candidate, company).
APPLY_CAP_PER_WINDOW=5
APPLY_CAP_WINDOW_DAYS=180

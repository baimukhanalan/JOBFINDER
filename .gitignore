# --- Extra PII/secret exclusions (data backups, address map, generated outputs) ---
# Timestamped backups of profiles/facts/mail_addresses hold the same PII as the
# originals, so they must never be committed either.
backend/data/*.bak
backend/data/*.bak-*
backend/data/facts.bak-*/
backend/data/mail_addresses.json
# Generated dashboards / screenshots can embed candidate data.
outputs/
backend/data/mailbox_passwords.json

# local logs + crontab backups (never commit — may contain other projects secrets)
logs/
